{
  "name": "elecschema",
  "productName": "ElecSchema",
  "version": "0.1.0",
  "private": true,
  "description": "Éditeur de schémas unifilaires pour installations domestiques (RGIE/AREI, Belgique). 100 % local.",
  "author": "Usage personnel",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "be.elecschema.app",
    "productName": "ElecSchema",
    "copyright": "Usage personnel",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "ElecSchema-portable-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
